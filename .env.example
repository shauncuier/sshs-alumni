###############################################################################
# প্রাক্তন ছাত্র-ছাত্রী পরিষদ — সবুজ শিক্ষায়তন সরকারি উচ্চ বিদ্যালয়
# Former Students Association — Sabuj Shikshayatan Government High School
#
# Copy to .env and fill in. Full reference: docs/12-environment.md
###############################################################################

# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME="SSHS Alumni"
APP_ENV=local
APP_KEY=
# NEVER true in production — it exposes env vars, credentials and stack traces.
APP_DEBUG=true
# Must be the real HTTPS domain in production, and set BEFORE any QR code is
# generated: a membership card printed with an http:// URL is wrong forever.
APP_URL=http://sshs-alumni.test

# বাংলা is the default for the public site; English is the fallback.
APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Dhaka

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Use `warning` in production. Logs must never contain passwords, API keys,
# session tokens or full member records.
LOG_LEVEL=debug

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite in development, MySQL in production. SQLite serialises writes and
# would fail at the Golden Jubilee check-in gate. See docs/13-deployment.md.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=sshs_alumni
# DB_USERNAME=sshs_alumni
# DB_PASSWORD=
# utf8mb4 is REQUIRED — MySQL's `utf8` is 3-byte and corrupts Bengali text.
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

# ─── Session ─────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Both true in production (SESSION_SECURE_COOKIE requires HTTPS).
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

# ─── Cache, queue, storage ───────────────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# A queue worker is REQUIRED in production. Without one, campaigns, exports and
# image variants silently never run.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail ────────────────────────────────────────────────────────────────────
# `log` writes mail to the log and sends nothing. Production needs a real
# provider (SES / Postmark / Mailgun) plus SPF, DKIM and DMARC on the sending
# domain, or campaigns land in spam.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# ─── SMS — BulkSMSBD (bulksmsbd.net) ─────────────────────────────────────────
# `log` writes messages to the log and sends nothing. It is the default outside
# production, so no test run or seeder can spend real balance.
SMS_DRIVER=log
# Master switch, independent of the driver.
SMS_ENABLED=false
# Hard ceiling on SEGMENTS per calendar day. A runaway campaign halts instead
# of draining the account.
SMS_DAILY_CAP=2000
SMS_COUNTRY_CODE=88

BULKSMSBD_BASE_URL=https://bulksmsbd.net/api
BULKSMSBD_API_KEY=
# Must be pre-approved by the vendor. An unapproved sender id returns error
# 1002 and every message fails.
BULKSMSBD_SENDER_ID=
BULKSMSBD_TIMEOUT=15
BULKSMSBD_RETRY_TIMES=2
BULKSMSBD_RETRY_SLEEP_MS=500
BULKSMSBD_BALANCE_CACHE=300

# BulkSMSBD mandates the OTP body format: "Your {Brand} OTP is XXXX".
# A message that does not match is rejected at the gateway. The brand must be
# LATIN-SCRIPT — a Bangla brand pushes the message to Unicode and breaks it.
SMS_OTP_BRAND="SSHS Alumni"
SMS_OTP_LENGTH=6
SMS_OTP_TTL=300

# ─── Payments ────────────────────────────────────────────────────────────────
# Only the manual/offline gateway is implemented. bKash, Nagad and SSLCommerz
# are added as driver classes plus their keys here. See docs/09-payments.md.
PAYMENT_GATEWAY=manual
PAYMENT_CURRENCY=BDT

# ─── Organization: the association (organiser of the Jubilee) ────────────────
ORG_NAME_BN="প্রাক্তন ছাত্র-ছাত্রী পরিষদ"
ORG_NAME_EN="Former Students Association"
ORG_ESTABLISHED=2015
ORG_CONTACT_EMAIL=
ORG_CONTACT_PHONE=

# ─── School: whose fifty years are celebrated ────────────────────────────────
# 1976 and 2015 are deliberately separate. The fifty years belong to the
# school; the association is the organiser. See docs/00-overview.md section 3.
SCHOOL_NAME_BN="সবুজ শিক্ষায়তন সরকারি উচ্চ বিদ্যালয়"
SCHOOL_NAME_EN="Sabuj Shikshayatan Government High School"
SCHOOL_ESTABLISHED=1976
SCHOOL_EIIN=105070
SCHOOL_ADDRESS="Hafiz Jute Mills Ltd, Baro Aulia, Sitakunda, Chattogram"
SCHOOL_PHONE=01745950025
SCHOOL_EMAIL=sabujshikha@yahoo.com
SCHOOL_WEBSITE=https://sabujsghs.edu.bd
SCHOOL_BOARD_BN="মাধ্যমিক ও উচ্চ মাধ্যমিক শিক্ষা বোর্ড, চট্টগ্রাম"

# NOTE: there is deliberately NO Golden Jubilee date variable. The date is not
# fixed, and is published by an administrator from /admin/jubilee. Until then
# every public surface renders "তারিখ শীঘ্রই ঘোষণা করা হবে".

# ─── AWS / object storage (optional) ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
